  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RunRequest": {
        "title": "soseek Run Request",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "pattern": "^(search|read|research|answer|[a-z]+\\.[a-z_]+)$"
          },
          "query": {
            "type": "string",
            "maxLength": 16000
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "provider": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "channel": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "profile": {
            "enum": [
              "quick",
              "broad",
              "deep"
            ]
          },
          "mode": {
            "enum": [
              "agent",
              "pipeline"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "budget_usd": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
          },
          "deadline_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          },
          "options": {
            "type": "object"
          },
          "input": {
            "type": "object"
          },
          "fresh": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "uncertain": {
            "type": "boolean"
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ]
      },
      "APIError": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "additionalProperties": false,
        "required": [
          "error"
        ]
      },
      "Request": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "provider": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "channel": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "profile": {
            "type": "string",
            "enum": [
              "quick",
              "broad",
              "deep"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "agent",
              "pipeline"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "budget_usd": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
          },
          "deadline_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1800
          },
          "options": {
            "type": "object",
            "additionalProperties": true
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          },
          "fresh": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "operation"
        ]
      },
      "PlanStep": {
        "type": "object",
        "properties": {
          "provider": {
